{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="max-w-sm mx-auto">
        <h1 class="text-2xl font-bold text-amber-900 mb-6">Connexion</h1>

        <form method="post" class="bg-white rounded-lg border border-stone-200 p-6">
            {% if error %}
                <div class="mb-4 px-4 py-3 rounded bg-red-100 text-red-800 text-sm">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <label for="username" class="block text-sm font-medium text-stone-700 mb-1">E-mail</label>
            <input type="email" name="_username" id="username" value="{{ last_username }}" required autofocus
                   class="w-full border border-stone-300 rounded px-3 py-2 mb-4">

            <label for="password" class="block text-sm font-medium text-stone-700 mb-1">Mot de passe</label>
            <input type="password" name="_password" id="password" required
                   class="w-full border border-stone-300 rounded px-3 py-2 mb-2">

            <a href="{{ path('app_forgot_password_request') }}" class="text-sm text-amber-900 hover:underline">
                Mot de passe oublié ?
            </a>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit"
                    class="w-full bg-amber-900 text-amber-50 font-medium px-4 py-2 rounded hover:bg-amber-800 transition mt-4">
                Se connecter
            </button>
        </form>

        <p class="text-sm text-stone-500 mt-4 text-center">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}" class="text-amber-900 font-medium hover:underline">Inscrivez-vous</a>
        </p>
    </div>
{% endblock %}
