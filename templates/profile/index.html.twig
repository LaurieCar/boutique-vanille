{% extends 'base.html.twig' %}

{% block title %}Mon compte{% endblock %}

{% block body %}
    <h1 class="text-3xl font-bold text-amber-900 mb-6">Mon compte</h1>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-1 space-y-6">
            <div class="bg-white rounded-lg border border-stone-200 p-6">
                <h2 class="text-lg font-semibold text-stone-800 mb-4">Informations personnelles</h2>

                {{ form_start(profileForm) }}
                    {{ form_row(profileForm.prenom, {attr: {class: 'w-full border border-stone-300 rounded px-3 py-2'}, label_attr: {class: 'block text-sm font-medium text-stone-700 mb-1'}}) }}
                    {{ form_row(profileForm.nom, {attr: {class: 'w-full border border-stone-300 rounded px-3 py-2'}, label_attr: {class: 'block text-sm font-medium text-stone-700 mb-1'}}) }}
                    {{ form_row(profileForm.email, {attr: {class: 'w-full border border-stone-300 rounded px-3 py-2'}, label_attr: {class: 'block text-sm font-medium text-stone-700 mb-1'}}) }}

                    <button type="submit"
                            class="w-full bg-amber-900 text-amber-50 font-medium px-4 py-2 rounded hover:bg-amber-800 transition mt-2">
                        Enregistrer
                    </button>
                {{ form_end(profileForm) }}
            </div>

            <div class="bg-white rounded-lg border border-stone-200 p-6">
                <h2 class="text-lg font-semibold text-stone-800 mb-4">Changer de mot de passe</h2>

                {{ form_start(passwordForm) }}
                    {{ form_row(passwordForm.currentPassword, {attr: {class: 'w-full border border-stone-300 rounded px-3 py-2'}, label_attr: {class: 'block text-sm font-medium text-stone-700 mb-1'}}) }}
                    {{ form_row(passwordForm.plainPassword.first, {attr: {class: 'w-full border border-stone-300 rounded px-3 py-2'}, label_attr: {class: 'block text-sm font-medium text-stone-700 mb-1'}}) }}
                    {{ form_row(passwordForm.plainPassword.second, {attr: {class: 'w-full border border-stone-300 rounded px-3 py-2'}, label_attr: {class: 'block text-sm font-medium text-stone-700 mb-1'}}) }}

                    <button type="submit"
                            class="w-full bg-amber-900 text-amber-50 font-medium px-4 py-2 rounded hover:bg-amber-800 transition mt-2">
                        Changer le mot de passe
                    </button>
                {{ form_end(passwordForm) }}
            </div>
        </div>

        <div class="lg:col-span-2">
            <h2 class="text-lg font-semibold text-stone-800 mb-4">Mes commandes</h2>

            {% if commandes is empty %}
                <p class="text-stone-500">Vous n'avez pas encore passé de commande.</p>
            {% else %}
                <div class="space-y-4">
                    {% for commande in commandes %}
                        <div class="bg-white rounded-lg border border-stone-200 p-4">
                            <div class="flex items-center justify-between gap-4 mb-3">
                                <div>
                                    <p class="font-semibold text-stone-800">Commande #{{ commande.id }}</p>
                                    <p class="text-sm text-stone-500">{{ commande.createdAt|date('d/m/Y H:i') }}</p>
                                </div>

                                <span class="text-sm px-2 py-1 rounded {{ commande.statut.value == 'payee' ? 'bg-green-100 text-green-800' : 'bg-stone-100 text-stone-600' }}">
                                    {{ commande.statut.value == 'payee' ? 'Payée' : 'En attente' }}
                                </span>

                                <p class="w-24 text-right font-semibold text-stone-800">
                                    {{ (commande.montantTotal / 100)|number_format(2, ',', ' ') }} €
                                </p>
                            </div>

                            <div class="divide-y divide-stone-100 border-t border-stone-100">
                                {% for ligne in commande.items %}
                                    <div class="flex items-center gap-3 py-2">
                                        {% if ligne.product and ligne.product.imagePrincipale %}
                                            <img src="{{ asset('uploads/products/images/' ~ ligne.product.imagePrincipale) }}"
                                                 alt="{{ ligne.nomProduit }}"
                                                 class="w-12 h-12 object-cover rounded shrink-0">
                                        {% else %}
                                            <div class="w-12 h-12 bg-stone-100 rounded shrink-0"></div>
                                        {% endif %}

                                        <div class="flex-1">
                                            <p class="text-sm font-medium text-stone-800">{{ ligne.nomProduit }}</p>
                                            <p class="text-xs text-stone-500">
                                                {{ (ligne.prixUnitaire / 100)|number_format(2, ',', ' ') }} € x {{ ligne.quantite }}
                                            </p>
                                        </div>

                                        <p class="text-sm font-semibold text-stone-800">
                                            {{ (ligne.sousTotal / 100)|number_format(2, ',', ' ') }} €
                                        </p>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
