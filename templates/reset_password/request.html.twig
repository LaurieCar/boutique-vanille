{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
    <div class="max-w-sm mx-auto">
        <h1 class="text-2xl font-bold text-amber-900 mb-6">Mot de passe oublié</h1>

        <p class="text-sm text-stone-600 mb-4">
            Saisissez votre e-mail, nous vous enverrons un lien pour réinitialiser votre mot de passe.
        </p>

        {{ form_start(requestForm, {attr: {class: 'bg-white rounded-lg border border-stone-200 p-6'}}) }}
            {{ form_row(requestForm.email, {attr: {class: 'w-full border border-stone-300 rounded px-3 py-2'}, label_attr: {class: 'block text-sm font-medium text-stone-700 mb-1'}}) }}

            <button type="submit"
                    class="w-full bg-amber-900 text-amber-50 font-medium px-4 py-2 rounded hover:bg-amber-800 transition mt-2">
                Envoyer le lien de réinitialisation
            </button>
        {{ form_end(requestForm) }}
    </div>
{% endblock %}
