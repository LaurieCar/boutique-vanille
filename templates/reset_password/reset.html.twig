{% extends 'base.html.twig' %}

{% block title %}Réinitialiser le mot de passe{% endblock %}

{% block body %}
    <div class="max-w-sm mx-auto">
        <h1 class="text-2xl font-bold text-amber-900 mb-6">Choisissez un nouveau mot de passe</h1>

        {{ form_start(resetForm, {attr: {class: 'bg-white rounded-lg border border-stone-200 p-6'}}) }}
            {{ form_row(resetForm.plainPassword.first, {attr: {class: 'w-full border border-stone-300 rounded px-3 py-2'}, label_attr: {class: 'block text-sm font-medium text-stone-700 mb-1'}}) }}
            {{ form_row(resetForm.plainPassword.second, {attr: {class: 'w-full border border-stone-300 rounded px-3 py-2'}, label_attr: {class: 'block text-sm font-medium text-stone-700 mb-1'}}) }}

            <button type="submit"
                    class="w-full bg-amber-900 text-amber-50 font-medium px-4 py-2 rounded hover:bg-amber-800 transition mt-2">
                Réinitialiser le mot de passe
            </button>
        {{ form_end(resetForm) }}
    </div>
{% endblock %}
