{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
    <div class="max-w-sm mx-auto">
        <h1 class="text-2xl font-bold text-amber-900 mb-6">Créer un compte</h1>

        {{ form_start(registrationForm, {attr: {class: 'bg-white rounded-lg border border-stone-200 p-6'}}) }}
            {{ form_row(registrationForm.prenom, {attr: {class: 'w-full border border-stone-300 rounded px-3 py-2'}, label_attr: {class: 'block text-sm font-medium text-stone-700 mb-1'}}) }}
            {{ form_row(registrationForm.nom, {attr: {class: 'w-full border border-stone-300 rounded px-3 py-2'}, label_attr: {class: 'block text-sm font-medium text-stone-700 mb-1'}}) }}
            {{ form_row(registrationForm.email, {attr: {class: 'w-full border border-stone-300 rounded px-3 py-2'}, label_attr: {class: 'block text-sm font-medium text-stone-700 mb-1'}}) }}
            {{ form_row(registrationForm.plainPassword.first, {attr: {class: 'w-full border border-stone-300 rounded px-3 py-2'}, label_attr: {class: 'block text-sm font-medium text-stone-700 mb-1'}}) }}
            {{ form_row(registrationForm.plainPassword.second, {attr: {class: 'w-full border border-stone-300 rounded px-3 py-2'}, label_attr: {class: 'block text-sm font-medium text-stone-700 mb-1'}}) }}

            <button type="submit"
                    class="w-full bg-amber-900 text-amber-50 font-medium px-4 py-2 rounded hover:bg-amber-800 transition mt-2">
                S'inscrire
            </button>
        {{ form_end(registrationForm) }}

        <p class="text-sm text-stone-500 mt-4 text-center">
            Déjà un compte ?
            <a href="{{ path('app_login') }}" class="text-amber-900 font-medium hover:underline">Connectez-vous</a>
        </p>
    </div>
{% endblock %}
