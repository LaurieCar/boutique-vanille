{% extends 'base.html.twig' %}

{% block title %}{{ product.nom }}{% endblock %}

{% block body %}
    {% if app.request.query.get('ajout') %}
        <div class="fixed inset-0 bg-stone-900/50 flex items-center justify-center z-50 px-4">
            <div class="relative bg-white rounded-lg shadow-xl max-w-sm w-full p-6 text-center">
                <a href="{{ path('app_product_show', {slug: product.slug}) }}"
                   class="absolute top-3 right-3 text-stone-400 hover:text-stone-600" aria-label="Fermer">
                    &times;
                </a>

                <p class="text-lg font-semibold text-stone-800 mb-6">Produit ajouté au panier</p>

                <div class="flex flex-col gap-3">
                    <a href="{{ path('app_cart_index') }}"
                       class="bg-amber-900 text-amber-50 font-medium px-4 py-2 rounded hover:bg-amber-800 transition">
                        Consulter mon panier
                    </a>
                    <a href="{{ path('app_product_index') }}"
                       class="border border-stone-300 text-stone-700 font-medium px-4 py-2 rounded hover:bg-stone-50 transition">
                        Retour à la boutique
                    </a>
                </div>
            </div>
        </div>
    {% endif %}

    <a href="{{ path('app_product_index') }}" class="text-amber-900 text-sm font-medium hover:underline">
        &larr; Retour au catalogue
    </a>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-4">
        <div>
            <div class="aspect-square bg-amber-100 rounded-lg flex items-center justify-center overflow-hidden">
                {% if product.imagePrincipale %}
                    <img src="{{ asset('uploads/products/images/' ~ product.imagePrincipale) }}"
                         alt="{{ product.nom }}" class="w-full h-full object-cover">
                {% else %}
                    <span class="text-amber-400 text-sm">Pas d'image</span>
                {% endif %}
            </div>

            {% if product.video %}
                <video controls class="w-full rounded-lg mt-4">
                    <source src="{{ asset('uploads/products/videos/' ~ product.video) }}">
                </video>
            {% endif %}
        </div>

        <div>
            <p class="text-sm text-amber-700 font-medium uppercase tracking-wide">{{ product.categorie.nom }}</p>
            <h1 class="text-3xl font-bold text-stone-800 mt-1">{{ product.nom }}</h1>
            <p class="text-2xl font-bold text-amber-900 mt-4">{{ (product.prix / 100)|number_format(2, ',', ' ') }} €</p>

            <p class="text-stone-600 mt-4 leading-relaxed">{{ product.description }}</p>

            {% if product.stock <= 0 %}
                <p class="inline-block mt-6 text-sm font-medium text-red-700 bg-red-100 px-3 py-1 rounded">
                    Rupture de stock
                </p>
            {% else %}
                <p class="text-sm text-stone-500 mt-6">{{ product.stock }} en stock</p>

                <form action="{{ path('app_cart_add', {id: product.id}) }}" method="post" class="flex items-center gap-3 mt-4">
                    <input type="hidden" name="_token" value="{{ csrf_token('cart') }}">
                    <input type="number" name="quantite" value="1" min="1" max="{{ product.stock }}"
                           class="w-20 border border-stone-300 rounded px-2 py-1">
                    <button type="submit"
                            class="bg-amber-900 text-amber-50 font-medium px-4 py-2 rounded hover:bg-amber-800 transition">
                        Ajouter au panier
                    </button>
                </form>
            {% endif %}
        </div>
    </div>
{% endblock %}
