{% extends 'base.html.twig' %}

{% block title %}Merci pour votre commande{% endblock %}

{% block body %}
    <div class="max-w-lg mx-auto text-center py-12">
        <h1 class="text-3xl font-bold text-amber-900 mb-4">Merci pour votre commande !</h1>

        {% if commande %}
            <p class="text-stone-600">
                Un e-mail de confirmation sera envoyé à <strong>{{ commande.email }}</strong>
                dès que votre paiement sera confirmé.
            </p>
            <p class="text-stone-500 text-sm mt-2">
                Montant : {{ (commande.montantTotal / 100)|number_format(2, ',', ' ') }} €
            </p>
        {% else %}
            <p class="text-stone-600">Votre paiement est en cours de traitement.</p>
        {% endif %}

        <a href="{{ path('app_product_index') }}" class="text-amber-900 font-medium hover:underline mt-6 inline-block">
            &larr; Retour à la boutique
        </a>
    </div>
{% endblock %}
