{% extends 'base.html.twig' %}

{% block title %}Recettes{% endblock %}

{% block body %}
    <h1 class="text-3xl font-bold text-amber-900 mb-2">Recettes</h1>
    <p class="text-stone-600 mb-8">Quelques idées pour cuisiner nos produits, en vidéo.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for recipe in recipes %}
            <div class="bg-white rounded-lg shadow-sm border border-stone-200 overflow-hidden">
                <div class="aspect-video">
                    <iframe class="w-full h-full"
                            src="https://www.youtube.com/embed/{{ recipe.youtubeId }}"
                            title="{{ recipe.titre }}"
                            frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen></iframe>
                </div>
                <div class="p-4">
                    <h2 class="font-semibold text-stone-800">{{ recipe.titre }}</h2>
                    <p class="text-sm text-stone-600 mt-1">{{ recipe.description }}</p>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
