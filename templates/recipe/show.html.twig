{% extends 'base.html.twig' %}

{% block title %}{{ recipe.titre }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
{% endblock %}

{% block body %}
    <a href="{{ path('app_recipe_index') }}" class="inline-flex items-center text-amber-900 text-sm font-medium hover:underline mb-4">
        <svg class="w-4 h-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        Retour aux recettes
    </a>

    <div class="bg-white rounded-lg shadow-sm border border-stone-200 overflow-hidden mb-8">
        <div class="aspect-video bg-gradient-to-br from-amber-100 to-amber-200 flex items-center justify-center relative overflow-hidden">
            {% if recipe.youtubeId %}
                <img src="https://img.youtube.com/vi/{{ recipe.youtubeId }}/hqdefault.jpg"
                     alt="{{ recipe.titre }}"
                     class="absolute inset-0 w-full h-full object-cover">
            {% else %}
                <svg class="w-20 h-20 text-amber-400/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z"/>
                </svg>
            {% endif %}
        </div>

        <div class="p-6 md:p-8">
            <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="bg-amber-100 text-amber-900 text-xs font-medium px-3 py-1 rounded-full">{{ recipe.categorie }}</span>
                {% if recipe.difficulte %}
                    <span class="bg-stone-100 text-stone-700 text-xs font-medium px-3 py-1 rounded-full">{{ recipe.difficulte }}</span>
                {% endif %}
                {% if recipe.portions %}
                    <span class="bg-stone-100 text-stone-700 text-xs font-medium px-3 py-1 rounded-full">{{ recipe.portions }} parts</span>
                {% endif %}
            </div>

            <h1 class="text-2xl md:text-3xl font-bold text-stone-800 mb-4">{{ recipe.titre }}</h1>
            <p class="text-stone-600 leading-relaxed">{{ recipe.description }}</p>

            <div class="flex flex-wrap items-center gap-4 md:gap-6 mt-4 pt-4 border-t border-stone-100 text-sm text-stone-500">
                {% if recipe.tempsPreparation %}
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center">
                            <svg class="w-4 h-4 text-amber-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>
                        <div>
                            <p class="font-medium text-stone-800 text-xs">Préparation</p>
                            <p>{{ recipe.tempsPreparation }} min</p>
                        </div>
                    </div>
                {% endif %}
                {% if recipe.tempsCuisson %}
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center">
                            <svg class="w-4 h-4 text-amber-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/>
                            </svg>
                        </div>
                        <div>
                            <p class="font-medium text-stone-800 text-xs">Cuisson</p>
                            <p>{{ recipe.tempsCuisson }} min</p>
                        </div>
                    </div>
                {% endif %}
                {% if recipe.tempsRepos %}
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center">
                            <svg class="w-4 h-4 text-amber-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                            </svg>
                        </div>
                        <div>
                            <p class="font-medium text-stone-800 text-xs">Repos</p>
                            <p>{{ recipe.tempsRepos }} min</p>
                        </div>
                    </div>
                {% endif %}
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center">
                        <svg class="w-4 h-4 text-amber-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                        </svg>
                    </div>
                    <div>
                        <p class="font-medium text-stone-800 text-xs">Ingrédients</p>
                        <p>{{ recipe.ingredients|length }}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 mb-8">
        <div class="lg:col-span-2">
            <div class="bg-white rounded-lg shadow-sm border border-stone-200 p-6 md:p-8 sticky top-8">
                <h2 class="text-lg font-bold text-stone-800 mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-amber-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                    Ingrédients
                </h2>
                <ul class="space-y-3">
                    {% for ingredient in recipe.ingredients %}
                        <li class="flex items-center gap-3 pb-3 border-b border-stone-100 last:border-b-0 last:pb-0">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 flex-shrink-0"></span>
                            <span class="text-sm text-stone-700">{{ ingredient.nom }}</span>
                            {% if ingredient.quantite %}
                                <span class="ml-auto text-sm font-medium text-amber-900 whitespace-nowrap">
                                    {{ ingredient.quantite }}{% if ingredient.unite %} {{ ingredient.unite }}{% endif %}
                                </span>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>

        <div class="lg:col-span-3">
            <div class="bg-white rounded-lg shadow-sm border border-stone-200 p-6 md:p-8">
                <h2 class="text-lg font-bold text-stone-800 mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-amber-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                    Préparation
                </h2>
                <ol class="space-y-4">
                    {% for instruction in recipe.instructions %}
                        <li class="flex gap-4">
                            <span class="flex-shrink-0 w-7 h-7 rounded-full bg-amber-900 text-amber-50 text-xs font-bold flex items-center justify-center mt-0.5">
                                {{ loop.index }}
                            </span>
                            <p class="text-sm text-stone-700 leading-relaxed pt-1">{{ instruction }}</p>
                        </li>
                    {% endfor %}
                </ol>
            </div>

            {% if recipe.youtubeId %}
                <div class="bg-white rounded-lg shadow-sm border border-stone-200 overflow-hidden mt-6">
                    <div class="aspect-video">
                        <iframe class="w-full h-full"
                                src="https://www.youtube.com/embed/{{ recipe.youtubeId }}"
                                title="{{ recipe.titre }}"
                                frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                allowfullscreen></iframe>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    {% if recettesSimilaires is not empty %}
        <div class="mb-8">
            <h2 class="text-xl font-bold text-stone-800 mb-6">Dans la même catégorie</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for similaire in recettesSimilaires %}
                    <a href="{{ path('app_recipe_show', {slug: similaire.slug}) }}"
                       class="bg-white rounded-lg shadow-sm border border-stone-200 overflow-hidden hover:shadow-md transition block group">
                        <div class="aspect-video bg-gradient-to-br from-amber-100 to-amber-200 flex items-center justify-center relative overflow-hidden">
                            {% if similaire.youtubeId %}
                                <img src="https://img.youtube.com/vi/{{ similaire.youtubeId }}/hqdefault.jpg"
                                     alt="{{ similaire.titre }}" loading="lazy"
                                     class="absolute inset-0 w-full h-full object-cover">
                            {% else %}
                                <svg class="w-12 h-12 text-amber-400/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z"/>
                                </svg>
                            {% endif %}
                        </div>
                        <div class="p-4">
                            <h3 class="font-semibold text-stone-800 group-hover:text-amber-900 transition-colors">{{ similaire.titre }}</h3>
                            <p class="text-sm text-stone-600 mt-1 line-clamp-2">{{ similaire.description }}</p>
                        </div>
                    </a>
                {% endfor %}
            </div>
        </div>
    {% endif %}
{% endblock %}
