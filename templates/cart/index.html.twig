{% extends 'base.html.twig' %}

{% block title %}Mon panier{% endblock %}

{% block body %}
    <h1 class="text-3xl font-bold text-amber-900 mb-6">Mon panier</h1>

    {% if items is empty %}
        <p class="text-stone-500">Votre panier est vide.</p>
        <a href="{{ path('app_product_index') }}" class="text-amber-900 font-medium hover:underline mt-4 inline-block">
            &larr; Voir nos produits
        </a>
    {% else %}
        <div class="bg-white rounded-lg border border-stone-200 divide-y divide-stone-200">
            {% for item in items %}
                <div class="flex items-center gap-4 p-4">
                    <div class="flex-1">
                        <p class="font-semibold text-stone-800">{{ item.product.nom }}</p>
                        <p class="text-sm text-stone-500">{{ (item.product.prix / 100)|number_format(2, ',', ' ') }} € / unité</p>
                    </div>

                    <form action="{{ path('app_cart_update', {id: item.product.id}) }}" method="post" class="flex items-center gap-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('cart') }}">
                        <input type="number" name="quantite" value="{{ item.quantite }}" min="1" max="{{ item.product.stock }}"
                               class="w-16 border border-stone-300 rounded px-2 py-1">
                        <button type="submit" class="text-sm text-amber-900 font-medium hover:underline">
                            Mettre à jour
                        </button>
                    </form>

                    <p class="w-24 text-right font-semibold text-stone-800">
                        {{ (item.sousTotal / 100)|number_format(2, ',', ' ') }} €
                    </p>

                    <form action="{{ path('app_cart_remove', {id: item.product.id}) }}" method="post">
                        <input type="hidden" name="_token" value="{{ csrf_token('cart') }}">
                        <button type="submit" class="text-sm text-red-700 hover:underline">
                            Supprimer
                        </button>
                    </form>
                </div>
            {% endfor %}
        </div>

        <div class="flex justify-end mt-4">
            <p class="text-xl font-bold text-stone-800">
                Total : {{ (total / 100)|number_format(2, ',', ' ') }} €
            </p>
        </div>

        <form action="{{ path('app_checkout_create') }}" method="post" data-turbo="false"
              class="bg-white rounded-lg border border-stone-200 p-6 mt-6 max-w-md ml-auto">
            <input type="hidden" name="_token" value="{{ csrf_token('checkout') }}">

            <label for="email" class="block text-sm font-medium text-stone-700 mb-1">
                E-mail de contact
            </label>
            <input type="email" id="email" name="email" required
                   class="w-full border border-stone-300 rounded px-3 py-2 mb-4">

            <button type="submit"
                    class="w-full bg-amber-900 text-amber-50 font-medium px-4 py-2 rounded hover:bg-amber-800 transition">
                Payer {{ (total / 100)|number_format(2, ',', ' ') }} €
            </button>
        </form>
    {% endif %}
{% endblock %}
